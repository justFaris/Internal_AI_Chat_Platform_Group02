# ---------------------------------------------------------------------------
# Open WebUI environment template — Azure OpenAI backend
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env is git-ignored. Only this template is committed, and it must never
# contain a real key. Every value below is a placeholder.
#
# Azure OpenAI naming, used throughout this file:
#   resource    the Azure OpenAI account, e.g. openwebui-aoai
#   deployment  the model deployment inside it, e.g. gpt-5-mini
#   resource group  rg-openwebui
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. AZURE OPENAI  (required — nothing works without this)
# ===========================================================================

# Endpoint. Azure exposes an OpenAI-compatible surface at the /openai/v1 path;
# this is the form Microsoft documents for OpenAI SDK clients, and Open WebUI
# speaks the OpenAI Chat Completions protocol, so the two line up directly.
# No api-version query parameter is needed on this path.
#
# Find it with:  az cognitiveservices account show -g rg-openwebui -n openwebui-aoai --query endpoint -o tsv
OPENAI_API_BASE_URL=https://openwebui-aoai.openai.azure.com/openai/v1

# Key 1 or Key 2 of the Azure OpenAI account. Either works; they are two
# equally-privileged credentials for the same account, so you can rotate by
# writing the other one here and redeploying.
#
# Find it with:  az cognitiveservices account keys list -g rg-openwebui -n openwebui-aoai --query "[0].value" -o tsv
OPENAI_API_KEY=replace-with-azure-openai-key

# The deployment name is the model id Open WebUI will show and send. Azure
# routes on the deployment named in the request body, so this must match the
# deployment you created exactly — not the underlying model name.
#
#   az cognitiveservices account deployment create \
#     -g rg-openwebui -n openwebui-aoai -d gpt-5-mini \
#     --model-name gpt-5-mini --model-version 2025-08-01 \
#     --sku-name GlobalStandard
#
# Leave this empty to let Open WebUI fetch the deployment list from
# GET {OPENAI_API_BASE_URL}/models. Set it only to pin the model list, which
# also saves a round trip on every page load.
# OPENAI_DEFAULT_MODEL_ID=gpt-5-mini


# ===========================================================================
# 2. OPEN WEBUI SESSION SECRET  (required)
# ===========================================================================

# Signs the session JWT and encrypts sensitive values at rest.
# Generate with:  openssl rand -base64 32
#
# Changing this invalidates every existing session, so treat it as permanent
# once the platform has users. Back it up with the rest of the secrets.
WEBUI_SECRET_KEY=replace-with-a-generated-secret

# Optional: overrides the key that encrypts MFA authenticator secrets, so
# WEBUI_SECRET_KEY can be rotated without breaking everyone's 2FA. Only set
# this if MFA is actually enabled. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key


# ===========================================================================
# 3. PUBLIC ADDRESS OF THE VM  (required — drives the TLS certificate)
# ===========================================================================

# The static public IP Azure assigned. Caddy issues its internal certificate
# for exactly this address, so it must match the deployed IP or every browser
# gets a second, different warning on top of the self-signed one.
#
# Read it, never copy it — it is reallocated on every destroy and rebuild:
#   terraform -chdir=terraform output -raw public_ip
SITE_ADDRESS=203.0.113.10

# Same value, used by Open WebUI to build absolute URLs in emails and OIDC
# redirects. Not needed without OAuth, but harmless to keep in step.
# WEBUI_URL=https://203.0.113.10


# ===========================================================================
# 4. BROWSER ACCESS CONTROL  (required in production)
# ===========================================================================

# Open WebUI defaults to "*", which lets any site a logged-in user happens to
# visit issue requests to this instance. Pin it to the site's own origin.
CORS_ALLOW_ORIGIN=https://203.0.113.10

# Separate origins are semicolon-separated. Add https://localhost if you also
# reach the app through the SSH tunnel — that is a different origin from the
# public IP and requests would be refused without it.
# CORS_ALLOW_ORIGIN=https://203.0.113.10;https://localhost


# ===========================================================================
# 5. AUTHENTICATION AND ACCESS CONTROL
# ===========================================================================
# These are also set in docker-compose.yml. They are listed here for
# reference; docker-compose.yml is authoritative for what the container
# receives.
#
#   WEBUI_AUTH=true
#   ENABLE_SIGNUP=true          open registration, but see below
#   DEFAULT_USER_ROLE=pending   a new account can do nothing until approved
#   WEBUI_SESSION_COOKIE_SECURE=true
#   WEBUI_SESSION_COOKIE_SAME_SITE=strict
#
# ENABLE_SIGNUP is a ConfigVar: after the first start the database value wins
# over this environment variable. Change it in the Admin Panel, not here.


# ===========================================================================
# 6. AZURE OPENAI FOR EMBEDDINGS / RAG  (optional)
# ===========================================================================
# Unset, these fall back to OPENAI_API_BASE_URL and OPENAI_API_KEY above,
# which is correct when the chat deployment and the embedding deployment live
# in the same account. Set them only to split the two.
#
# RAG_AZURE_OPENAI_BASE_URL=https://openwebui-aoai.openai.azure.com
# RAG_AZURE_OPENAI_API_KEY=replace-with-azure-openai-key
# RAG_AZURE_OPENAI_API_VERSION=2024-10-21
# RAG_EMBEDDING_ENGINE=text-embedding-3-large
# RAG_EMBEDDING_MODEL=embeddings


# ===========================================================================
# 7. AUDIO TRANSCRIPTION AND SPEECH  (optional)
# ===========================================================================
# Leave unset to keep these features off. Both need their own Azure OpenAI
# audio deployment, which is not created by the command in section 1.
#
# AUDIO_STT_OPENAI_API_BASE_URL=${OPENAI_API_BASE_URL}
# AUDIO_STT_OPENAI_API_KEY=${OPENAI_API_KEY}
# AUDIO_STT_AZURE_API_KEY=replace-with-azure-openai-key
# AUDIO_STT_ENGINE=whisper-1
# AUDIO_TTS_OPENAI_API_BASE_URL=${OPENAI_API_BASE_URL}
# AUDIO_TTS_OPENAI_API_KEY=${OPENAI_API_KEY}
# AUDIO_TTS_VOICE=alloy
# AUDIO_TTS_MODEL=tts-1


# ===========================================================================
# 8. TIME OUTS AND TUNING  (optional)
# ===========================================================================
# Azure OpenAI is usually fast, but the first call after a cold start can be
# slow enough for the default 10 s model-list fetch to give up.
# AIOHTTP_CLIENT_TIMEOUT_MODEL_LIST=30
# AIOHTTP_CLIENT_TIMEOUT=300

# The default worker pool of 40 is far too small for a real server and shows
# up as the whole app freezing under a few concurrent users. Raise it.
# THREAD_POOL_SIZE=2000


# ===========================================================================
# 9. CHECKLIST BEFORE `docker compose up -d`
# ===========================================================================
#   [ ] No real key left in this file — only this template is committed
#   [ ] chmod 600 .env, owned by the deploying user
#   [ ] OPENAI_API_BASE_URL ends in /openai/v1
#   [ ] SITE_ADDRESS matches `terraform output -raw public_ip` right now
#   [ ] CORS_ALLOW_ORIGIN matches SITE_ADDRESS, scheme included
#   [ ] the deployment named in section 1 exists:
#         az cognitiveservices account deployment list \
#           -g rg-openwebui -n openwebui-aoai -o table
#   [ ] key is live:
#         curl -sS -o /dev/null -w '%{http_code}\n' \
#           -H "api-key: $OPENAI_API_KEY" \
#           "$OPENAI_API_BASE_URL/models"
#       expect 200
